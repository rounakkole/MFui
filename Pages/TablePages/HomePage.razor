@page "/"
@using MFui.Data
@using MFui.Data.Enums
@using MFui.Pages
@using MFui.Services
@using BlazorBootstrap
@using TG.Blazor.IndexedDB

@inject ITransactionService TransactionService
@inject INAVResponseService NAVResponseService

@inject ToastService ToastService
@inject IndexedDBManager DbManager

<PageTitle>MFui</PageTitle>
<!-- <h3>MFui</h3> -->

<div>
    @if (investmentsList == null || !investmentsList.Any())
    {
        <div class="text-center p-5 text-muted bg-light rounded-3 shadow-sm">
            <i class="bi bi-wallet2 display-4 mb-3 d-block text-secondary"></i>
            <h5 class="text-secondary">No Active SIPs Found</h5>
            
            <a href="MobileViewPage" class="btn btn-secondary">Explore</a>
        </div>
    }
    else
    {
       
        <div class="row g-4">
            @foreach (var investment in investmentsList)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="mb-2">
                                <a href="@($"NAVResponsePage?schemeCode={investment.SchemeCode}")" class="text-decoration-none stretched-link">
                                    <h10 class="card-title fw-bold mb-1" title="@investment.SchemeName">
                                        @investment.SchemeName
                                    </h10>
                                </a>
                            </div>

                            <div class="d-flex justify-content-between align-items-end mt-auto">
                                <div>
                                    <p class="text-muted small mb-1">Start Date</p>
                                    <span class="fw-medium small">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                                        @investment.StartDate.ToString("dd MMM yyyy")
                                    </span>
                                </div>
                                <div class="d-flex flex-column align-items-end">
                                    <span class="badge bg-light text-secondary border">@investment.Frequency</span>
                                    <span class="fw-bold fs-5">
                                        ₹@investment.SIPamount.ToString("N0")
                                    </span>
                                </div>
                            </div>

                            @if (investment.TotalsTable != null)
                            {
                                <div class="mt-auto pt-1 border-top">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="text-muted mb-0 lh-1" style="font-size: 0.75rem;">Invested</p>
                                            ₹@investment.TotalsTable.InvestedAmount.ToString("N0")
                                        </div>
                                        <div class="text-center">
                                            <p class="text-muted mb-0 lh-1" style="font-size: 0.75rem;">Returns</p>
                                            @investment.TotalsTable.Returns.ToString("F2")%
                                        </div>
                                        <div class="text-end">
                                            <p class="text-muted mb-0 lh-1" style="font-size: 0.75rem;">Current</p>
                                            ₹@investment.TotalsTable.TotalValue.ToString("N0")
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>


        <br />
        <!-- <div>
            <button @onclick="calculateAllTransactions" class="btn btn-secondary"><i class="bi bi-calculator"></i></button>
        </div> -->
    }
    <br />
    <br />
</div>


@code {
    private List<InvestmentTable>? investmentsList = new();

    private string schemeCode = string.Empty;
    private DateOnly startDate = DateOnly.FromDateTime(DateTime.UtcNow).AddMonths(-2);
    private DateOnly endDate = DateOnly.FromDateTime(DateTime.UtcNow);


    protected override async Task OnInitializedAsync()
    {
        List<InvestmentTable>? localRecords = await DbManager.GetRecords<InvestmentTable>("InvestmentTable");
        if (localRecords != null && localRecords.Count > 0)
        {
            investmentsList = localRecords;
        }

    }



    private async Task calculateAllTransactions()
    {

        TransactionService.NAVResponseCTOR(NAVResponseService);
        await TransactionService.CalculateAllTransactions();
        
        ToastService.Notify(new ToastMessage(
                ToastType.Success,
                "Calculation triggered",
                $"All SIPs has been successfully calculated."
            ));
    }

}
