@page "/NAVResponsePage"
@using MFui.Data
@using MFui.Data.Enums
@using MFui.Pages
@using MFui.Services
@using BlazorBootstrap
@using TG.Blazor.IndexedDB

@inject INAVResponseService NAVResponseService

@inject ToastService ToastService
@inject IndexedDBManager DbManager

<PageTitle>Investments</PageTitle>
<h3>Investments</h3>

<div class="row g-2">
    <!-- <input TValue="DateOnly" @bind="startDate" class="form-control" placeholder="Start Date" /> -->
    <!-- <input TValue="DateOnly" @bind="endDate" class="form-control" placeholder="End Date" /> -->
    <div class="col-6 col-md-3">
        <DateInput TValue="DateOnly" @bind-Value="@startDate" Placeholder="Start Date" />
    </div>
    <div class="col-6 col-md-3">
        <DateInput TValue="DateOnly" @bind-Value="@endDate" Placeholder="End Date" />
    </div>
    <div class="col-6 col-md-4">
        <input @bind="schemeCode" class="form-control" placeholder="Scheme Code" />
    </div>
    <div class="col-6 col-md-2">
        <button @onclick="getNAVResponse" class="btn btn-primary"><i class="bi bi-search"></i></button>
    </div>
</div>

<br />

<div>
    @if (navResponse == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <Accordion>
            <AccordionItem Title="Scheme">
                <Content>
                    <p>
                        @navResponse.Meta.SchemeCode
                        @navResponse.Meta.SchemeName
                    </p>
                    <p>@navResponse.Meta.SchemeType</p>
                    <p>@navResponse.Meta.SchemeCategory</p>
                </Content>
            </AccordionItem>
            <AccordionItem Title="Chart" Active="true">
                <Content>

                    <LineChartWidget navResponse="@navResponse" @key="navResponse" />

                </Content>
            </AccordionItem>
        </Accordion>



        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <!-- <h5 class="card-title text-muted mb-4">Investment Details</h5> -->

                <EditForm Model="newInvestmentRecord" OnValidSubmit="addToInvestments">
                <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select id="frequency" class="form-select" @bind="newInvestmentRecord.Frequency">
                                    @foreach (Frequency freq in Enum.GetValues(typeof(Frequency)))
                                    {
                                        <option value="@freq">@freq</option>
                                    }
                                </select>
                                <label for="frequency">Frequency</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="number" id="amount" class="form-control" @bind="newInvestmentRecord.SIPamount" placeholder="Amount" />
                                <label for="amount">SIP Amount</label>

                                <ValidationMessage For="@(() => newInvestmentRecord.SIPamount)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="form-label text-muted small mb-1">Start Date</label>
                                <DateInput TValue="DateOnly" @bind-Value="newInvestmentRecord.StartDate" Placeholder="Select Date" />

                                <ValidationMessage For="@(() => newInvestmentRecord.StartDate)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-2 px-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label text-muted small mb-0">Step Up</label>
                                    <span class="badge bg-primary rounded-pill">@newInvestmentRecord.StepUp %</span>
                                </div>
                                <input type="range" class="form-range" @bind="newInvestmentRecord.StepUp" @bind:event="oninput" min="0" max="100" />
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-primary px-4 shadow-sm"> Save </button>
                    </div>

                </EditForm>
            </div>
        </div>



        @if (schemeOrderTable != null && schemeOrderTable.Any())
        {
            <div class="card border-0 shadow-sm rounded-3 mt-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">
                        @schemeOrderTable.Count() Transactions
                    </span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase sticky-top">
                                <tr>
                                    <th class="ps-4 fw-semibold border-bottom-0">Date</th>
                                    <th class="text-end fw-semibold border-bottom-0">Amount</th>
                                    <th class="pe-4 text-end fw-semibold border-bottom-0">NAV</th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @foreach (var order in schemeOrderTable)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium small">
                                            @order.TransactionDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td class="text-end fw-semibold">
                                            ₹@order.SIPamount.ToString("N0")
                                        </td>

                                        <td class="pe-4 text-end font-monospace small">
                                            @order.NAV.ToString("N4")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }



    }
    <br />
    <br />
</div>


@code {
    [SupplyParameterFromQuery]
    private string schemeCode { get; set; }

    private NAVResponse? navResponse;
    private InvestmentTable? investmentRecord;
    private InvestmentTable newInvestmentRecord { get; set; } = new();
    private List<OrderTable>? schemeOrderTable;

    private DateOnly startDate = DateOnly.FromDateTime(DateTime.UtcNow).AddMonths(-2);
    private DateOnly endDate = DateOnly.FromDateTime(DateTime.UtcNow);

    protected override async Task OnInitializedAsync()
    {
        await getNAVResponse();
        investmentRecord = await DbManager.GetRecordById<int, InvestmentTable>("InvestmentTable", navResponse.Meta.SchemeCode);
        if (investmentRecord != null)
        {
            newInvestmentRecord = investmentRecord;
        }
        else
        {
            newInvestmentRecord.SchemeCode = navResponse.Meta.SchemeCode;
            newInvestmentRecord.SchemeName = navResponse.Meta.SchemeName;
        }

        List<OrderTable> orderTables = await DbManager.GetRecords<OrderTable>("OrderTable");
        if (orderTables != null)
        {
            schemeOrderTable = orderTables.Where(x => x.SchemeCode == navResponse.Meta.SchemeCode).ToList();
        }
    }

    private async Task getNAVResponse()
    {
        navResponse = await NAVResponseService.GetNAVResponse(schemeCode, startDate, endDate);
    }

    private async Task addToInvestments()
    {
        try
        {
            StoreRecord<InvestmentTable> recordToSave = new StoreRecord<InvestmentTable>
            {
                Storename = "InvestmentTable", 
                Data = newInvestmentRecord
            };

            if (investmentRecord == null)
            {
                await DbManager.AddRecord(recordToSave);
            }
            else
            {
                await DbManager.UpdateRecord(recordToSave);
            }

            ToastService.Notify(new ToastMessage(
                    ToastType.Success,
                    "SIP Saved",
                    $"{newInvestmentRecord.SchemeName} has been successfully saved."
                ));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error: {ex.Message}");
        }
        

    }



}
